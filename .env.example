# ==============================================================================
# UZMEGATV — BOT SOZLAMALARI (.env)
# ==============================================================================

# Telegram Bot Token (@BotFather orqali olinadi)
BOT_TOKEN=1234567890:ABCDefghIJKlmnoPQRstuVWXyz123456789
BOT_USERNAME=uz_megatv_bot

# Bot administratorlarining Telegram ID lari (yoki usernamelari)
ADMIN_IDS=6786983910
ADMIN_USERNAMES=abdurahimoovvvv

# Ma'lumotlar bazasi URL manzili
# PostgreSQL uchun (Production):
# DATABASE_URL=postgresql+asyncpg://postgres:parol123@localhost:5432/uzmegatv
# SQLite uchun (Development va test):
DATABASE_URL=sqlite+aiosqlite:///uzmegatv.db

# Redis URL manzili (ixtiyoriy, agar ko'rsatilmasa MemoryStorage ishlatiladi)
# REDIS_URL=redis://localhost:6379/0

# So'rovlar chastotasi cheklovi (sekundlarda, spamdan himoya)
THROTTLE_RATE=0.7

# Har bir sahifada ko'rsatiladigan kinolar soni (pagination)
ITEMS_PER_PAGE=6

# Bot ish rejimi (production / development)
ENVIRONMENT=production
